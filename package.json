{
  "name": "onova-za-klientite",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --emit-ts-declarations --silent",
    "postinstall": "pnpm run i18n",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run i18n && tsc --noEmit && tsc --noEmit -p convex",
    "lint": "eslint",
    "knip": "knip",
    "check": "prettier --check .",
    "format": "prettier --write . && eslint --fix",
    "check-icons": "node scripts/check-icons.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "ci:preflight": "node scripts/ci-preflight.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/localizations": "^4.22.0",
    "@clerk/tanstack-react-start": "^1.6.5",
    "@convex-dev/workpool": "0.4.13",
    "@fontsource-variable/sofia-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.127",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "libphonenumber-js": "^1.13.14",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "papaparse": "^5.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^9.3.10",
    "satori": "0.32.0",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@inlang/paraglide-js": "^2.26.0",
    "@tanstack/eslint-config": "0.4.0",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.60",
    "eslint": "^9.20.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "knip": "^6.40.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
